#!/usr/bin/env bash
# rofi-i3nator — launch an i3nator layout via rofi
# Standalone alternative to `i3nator rofi`.
# Bind this to a hotkey in sxhkd, e.g.:
#   super + shift + i
#       ~/.script/rofi-i3nator

set -euo pipefail

selection=$(i3nator list | rofi -dmenu -i -p "i3nator:" -theme vercel-premium)

if [ -n "$selection" ]; then
    i3nator open "$selection"
fi
